{
  "name": "lecture-inbox",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev --workspace client",
    "dev:server": ".venv/bin/python -m uvicorn server.app:app --host 127.0.0.1 --port 4318 --no-access-log",
    "setup": "node scripts/setup.mjs",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "lecture": ".venv/bin/python -m server.lecture",
    "test": ".venv/bin/python -m unittest discover -s server -p 'test_*.py' -v"
  },
  "type": "module",
  "workspaces": [
    "client"
  ]
}
