# Vercel frontend environment. Never put a school password in a VITE_ variable.
VITE_API_BASE=https://api.your-domain.example

# OCI backend: exact frontend origins, comma-separated, no trailing slash.
FRONTEND_ORIGINS=https://your-app.vercel.app
API_DOMAIN=api.your-domain.example
SESSION_TTL_SECONDS=7200
FILE_TTL_SECONDS=1800
