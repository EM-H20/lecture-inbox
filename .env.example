# 선택 설정 안내. 서버는 이 파일을 읽지 않으니, 필요하면 실행할 때 환경변수로 지정하세요.
#   예: WHISPER_MODEL=small npm run dev
# 기본값으로 충분하면 아무것도 설정하지 않아도 됩니다.

# 사용할 Whisper 모델 크기: tiny, base, small, medium, large-v3 (기본 large-v3). 먼저 npm run lecture -- models --size <크기>
# WHISPER_MODEL=large-v3

# 학교에서 받은 영상 보관 시간(초)과 학교 로그인 유지 시간(초)
# FILE_TTL_SECONDS=1800
# SESSION_TTL_SECONDS=7200

# 화면을 localhost가 아닌 주소에서 열 때만: 허용할 화면 주소(쉼표로 구분, 끝에 / 없이)
# FRONTEND_ORIGINS=http://localhost:4317,http://127.0.0.1:4317

# 개발 서버 포트
# WEB_PORT=4317
# API_PORT=4318
